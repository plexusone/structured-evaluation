                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "recommendation": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "effort": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "type": "array"
          },
          "checklistResults": {
            "properties": {
              "requiredPresent": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "requiredMissing": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "optionalPresent": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "optionalMissing": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "description": "Finding severity: critical, high, medium, low, or info"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array"
    },
    "passCriteria": {
      "properties": {
        "minCategoriesPassing": {
          "type": "string"
        },
        "maxFindingsSeverity": {
          "properties": {
            "critical": {
              "type": "integer"
            },
            "high": {
              "type": "integer"
            },
            "medium": {
              "type": "integer"
            },
            "low": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "decision": {
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "conditional",
            "fail",
            "human_review"
          ],
          "description": "Decision status: pass, conditional, fail, or human_review"
        },
        "passed": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "findingCounts": {
          "properties": {
            "critical": {
              "type": "integer"
            },
            "high": {
              "type": "integer"
            },
            "medium": {
              "type": "integer"
            },
            "low": {
              "type": "integer"
            },
            "info": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "categoryCounts": {
          "properties": {
            "pass": {
              "type": "integer"
            },
            "partial": {
              "type": "integer"
            },
            "fail": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "overallDecision": {
      "type": "string",
      "enum": [
        "pass",
        "conditional",
        "fail",
        "human_review"
      ],
      "description": "Overall decision status"
