                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ],
                "description": "Finding severity: critical, high, medium, low, or info"
              },
              "owner": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        },
        "recommended": {
          "items": {
            "properties": {
              "action": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ],
                "description": "Finding severity: critical, high, medium, low, or info"
              },
              "owner": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "Rubric Report",
  "description": "Schema for rubric-based LLM-as-Judge evaluation reports"
}