        "id": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "expected_output": {
          "type": "string"
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "annotations": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "annotator_id": {
                "type": "string"
              },
              "annotator_type": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "categories": {
      "items": {
        "properties": {
          "category": {
            "type": "string"
          },
          "score": {
            "type": "string",
            "enum": [
              "pass",
              "partial",
              "fail"
            ],
            "description": "Category score: pass, partial, or fail"
          },
          "numericScore": {
            "type": "number"
          },
          "reasoning": {
            "type": "string"
          },
          "evidence": {
            "items": {
              "type": "string"
