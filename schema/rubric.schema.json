{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/structured-evaluation/schema/rubric.schema.json",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "properties": {
        "document": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "documentVersion": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatedBy": {
          "type": "string"
        },
        "reviewerId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "reviewType": {
      "type": "string"
    },
    "judge": {
      "properties": {
        "judge_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "prompt_template": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
