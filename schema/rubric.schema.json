          "type": "integer"
        },
        "tokens_used": {
          "properties": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            },
            "total_tokens": {
              "type": "integer"
            },
            "cache_read_tokens": {
              "type": "integer"
            },
            "cache_write_tokens": {
              "type": "integer"
            }
          },
