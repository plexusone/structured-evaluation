{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Valid enum values for structured evaluation types. Use these for validation in any language.",
  "enums": {
    "DecisionStatus": [
      "pass",
      "conditional",
      "fail",
      "human_review"
    ],
    "EvaluationMethod": [
      "deterministic",
      "semantic",
      "human"
    ],
    "EvaluationType": [
      "analytic",
      "holistic"
    ],
    "ScaleType": [
      "categorical",
      "checklist",
      "binary",
      "likert"
    ],
    "ScoreValue": [
      "pass",
      "partial",
      "fail"
    ],
    "Severity": [
      "critical",
      "high",
      "medium",
      "low",
      "info"
    ]
  },
  "title": "Structured Evaluation Enum Definitions",
  "validation": {
    "decisionStatus": {
      "description": "Decision status values",
      "passing": [
        "pass",
        "conditional"
      ],
      "usage": "Decision.status and overallDecision fields",
      "values": [
        "pass",
        "conditional",
        "fail",
        "human_review"
      ]
    },
    "evaluationMethod": {
      "description": "How an evaluation is performed: a mechanical check (Code-as-a-Judge), an LLM (LLM-as-a-Judge), or a human reviewer (Human-as-a-Judge)",
      "usage": "Category.evaluation, Criterion.evaluation, and JudgeMetadata.method fields",
      "values": [
        "deterministic",
        "semantic",
        "human"
      ]
    },
    "evaluationType": {
      "description": "Evaluation methodology types",
      "usage": "RubricSet.evaluationType field",
      "values": [
        "analytic",
        "holistic"
      ]
    },
    "scaleType": {
      "description": "Scale types for rubric categories",
      "usage": "Category.scale.type field",
      "values": [
        "categorical",
        "checklist",
        "binary",
        "likert"
      ]
    },
    "score": {
      "description": "Category score values",
      "usage": "CategoryResult.score field",
      "values": [
        "pass",
        "partial",
        "fail"
      ]
    },
    "severity": {
      "blocking": [
        "critical",
        "high"
      ],
      "description": "Finding severity levels",
      "usage": "Finding.severity field",
      "values": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    }
  }
}